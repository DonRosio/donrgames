# Copy to .env and adjust. Every variable is optional in development.

# production | development
# NODE_ENV=production

# Address and port of the Node server (behind a reverse proxy in production).
HOST=127.0.0.1
PORT=3000

# Public origin of the site (scheme + host + port). Required in production:
# used for the Content-Security-Policy and the WebSocket origin check.
# PUBLIC_ORIGIN=https://jeux.example.com

# Set to true when the server runs behind a reverse proxy (Caddy, nginx...).
TRUST_PROXY=false

# Folder containing the games content (content/<gameId>/selection.txt).
# CONTENT_DIR=./content

# fatal | error | warn | info | debug
LOG_LEVEL=info

# Limits
MAX_ROOMS=100
MAX_PLAYERS_PER_ROOM=10
