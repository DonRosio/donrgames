#!/bin/sh
# Git hook: copy it to ~/mini-jeux/repo.git/hooks/post-receive on the server (chmod +x).
# See docs/deployment.md. Nothing here touches content/ (outside the repository) or .env (outside
# the repository).
set -eu

# `systemctl --user` needs this when the hook runs outside an interactive session (git push
# over SSH). Requires `loginctl enable-linger mini-jeux`, done once by root (see the docs).
export XDG_RUNTIME_DIR="/run/user/$(id -u)"

WORKTREE="$HOME/mini-jeux/current"
GIT_DIR="$HOME/mini-jeux/repo.git"

git --work-tree="$WORKTREE" --git-dir="$GIT_DIR" checkout -f main
cd "$WORKTREE"
# The fonts are not in the repository (their licences do not allow redistributing them): put
# them once in ~/mini-jeux/fonts; they are copied to client/public/fonts before each build.
if [ -d "$HOME/mini-jeux/fonts" ]; then
  mkdir -p client/public/fonts
  cp -f "$HOME/mini-jeux/fonts/"*.woff2 client/public/fonts/
fi
cp "$WORKTREE/deploy/mini-jeux.service" "$HOME/.config/systemd/user/mini-jeux.service"
systemctl --user daemon-reload
npm ci
npm run build
systemctl --user restart mini-jeux
echo "Deployed: $(git --git-dir="$GIT_DIR" rev-parse --short main)"
