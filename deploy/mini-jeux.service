# systemd --user unit (no root): see docs/deployment.md.
# Adjust ExecStart if `which node` differs (Node installed by the chosen method).
[Unit]
Description=mini-jeux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mini-jeux/current
EnvironmentFile=%h/mini-jeux/current/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/src/index.ts
Restart=on-failure
RestartSec=5
# A crash leaves everything in RAM: nothing to clean up before restarting.

# Minimal hardening: the service already runs as an unprivileged user, and all the state is in
# RAM. The protections that isolate the file system or lower the "capabilities" (ProtectSystem,
# PrivateTmp, ProtectKernel*…) fail in a --user unit on Ubuntu 24.04
# (status=218/CAPABILITIES): they are not used.
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
