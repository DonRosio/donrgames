# Unité systemd --user (pas de root) : voir docs/deploiement.md.
# Ajuste ExecStart si `which node` diffère (installation Node par la méthode choisie).
[Unit]
Description=mini-jeux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mini-jeux/current
EnvironmentFile=%h/mini-jeux/current/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/src/index.ts
Restart=on-failure
RestartSec=5
# Un plantage laisse tout en RAM : rien à nettoyer avant de redémarrer.

# Durcissement minimal : le service tourne déjà sous un utilisateur sans privilège, et tout
# l'état est en RAM. Les protections qui isolent le système de fichiers ou abaissent les
# « capabilities » (ProtectSystem, PrivateTmp, ProtectKernel*…) échouent en unité --user sur
# Ubuntu 24.04 (status=218/CAPABILITIES) : elles ne sont pas utilisées.
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
